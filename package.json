{
  "name": "xiezhi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Controlled vibe coding platform for AI-assisted software development.",
  "packageManager": "pnpm@10.11.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "xz": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --dts --target node22 --clean --out-dir dist",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.1",
    "better-sqlite3": "^11.10.0",
    "commander": "^13.1.0",
    "drizzle-orm": "^0.44.2",
    "execa": "^9.6.0",
    "jsonc-parser": "^3.3.1",
    "picocolors": "^1.1.1",
    "pino": "^9.7.0",
    "smol-toml": "^1.3.4",
    "ts-morph": "^24.0.0",
    "yaml": "^2.8.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.21",
    "drizzle-kit": "^0.31.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
